  "cards": [
    {
      "dot": "cyan",
      "title": "分层与端口",
      "items": [
        "Presenters 是唯一入口：Hook 经 Token 取服务、订阅快照",
        "CompanionRuntime 单编排：state / replyDelta / generated / settled / error",
        "平台判断收敛在 app/hosts，tauri / browser / test 三宿主可换"
      ]
    },
    {
      "dot": "emerald",
      "title": "Tauri 壳",
      "items": [
        "remote.rs 局域网 HTTP：GET /api/messages · POST /api/send，token 鉴权",
        "手机消息经 remote://request 事件进同一条 runtime.submit 管线",
        "API Key 存 DPAPI secret_store，aika.db 经 tauri-plugin-sql"
      ]
    },
    {
      "dot": "violet",
      "title": "记忆与可观测",
      "items": [
        "记忆 V2：candidate / confirmed，删除落抑制标记并整段作废摘要",
        "滚动摘要 ≥40 条触发，≤200 字，经 latestSummary 进 system 提示词",
        "TraceEventV1 8 种事件落 trace_events，保留 7 天"
      ]
    }
  ]
