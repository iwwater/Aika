      "sublabel": "messages · trace_events",
      "stage": 4,
      "row": 2
    },
    {
      "id": "bg",
      "type": "backend",
      "label": "后台沉淀",
      "sublabel": "记忆抽取 + 滚动摘要",
      "stage": 4,
      "row": 3
    }
  ],
  "flows": [
    {
      "id": "mic-audio",
      "from": "mic",
      "to": "vad",
      "label": "音频帧",
      "classification": "PCM 流",
      "variant": "emphasis"
    },
    {
      "id": "speech-segments",
      "from": "vad",
      "to": "asr",
      "label": "语音段",
      "classification": "含 220ms preroll"
    },
    {
      "id": "transcript",
      "from": "asr",
      "to": "turn",
      "label": "转写文本",
      "classification": "保序合并"
    },
    {
      "id": "committed-turn",
      "from": "turn",
      "to": "ctx",
      "label": "提交回合",
      "classification": "submitTurn",
      "variant": "emphasis"
    },
    {
      "id": "recent-turns",
      "from": "hist",
      "to": "ctx",
      "label": "最近轮原文",
      "classification": "过滤 interrupted"
    },
    {
      "id": "memory-inject",
      "from": "mem",
      "to": "ctx",
      "label": "记忆 + 摘要注入",
      "classification": "top-8 · covers_until",
      "variant": "dashed"
    },
    {
      "id": "request-body",
      "from": "ctx",
      "to": "llm",
      "label": "请求体",
      "classification": "system + 单条 user"
    },
    {
      "id": "sse-delta",
      "from": "llm",
      "to": "parse",
      "label": "SSE 增量",
      "classification": "流式 JSON",
      "variant": "emphasis"
    },
    {
      "id": "sentences",
      "from": "parse",
      "to": "tts",
      "label": "分句文本",
      "classification": "边生成边念"
    },
    {
      "id": "caption-timing",
      "from": "tts",
      "to": "ui",
      "label": "朗读进度",
      "classification": "逐句高亮"
    },
    {
      "id": "persist",
      "from": "parse",
      "to": "store",
      "label": "持久化",
      "classification": "user 先写 · 回执后 final"
    },
    {
      "id": "recent-4",
      "from": "store",
      "to": "bg",
      "label": "最近 4 条",
      "classification": "completed 才触发",
      "variant": "dashed",
      "labelDx": -70
    },
    {
      "id": "writeback",
      "from": "bg",
      "to": "store",
      "label": "沉淀落库",
      "classification": "memories_v2 · summaries",
      "variant": "dashed",
      "labelDx": 78
    },
    {
      "id": "next-turn",
      "from": "bg",
      "to": "mem",
      "label": "下一轮可检索",
      "classification": "FTS top-8",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "上行：从声音到一轮话",
      "items": [
        "16 kHz 音频分帧后经 Silero VAD 切段（380ms 静音）",
        "whisper-server 转写并过滤幻听，turnEnd 1350 / 2400ms 判定说完",
        "本地识别不可用时自动降级系统 Web Speech"
      ]
    },
    {
      "dot": "amber",
      "title": "中间：记忆与上下文",
      "items": [
        "最近 16 轮原文 + 滚动摘要 + 记忆 top-8 进 instructions",
        "预算 4800 tokens 内按最近对话 → 摘要 → 记忆顺序裁剪",
        "摘要 ≥40 条未覆盖才滚动生成，≤200 字第三人称"
      ]
    },
    {
      "dot": "emerald",
      "title": "下行：一份解析，多处消费",
      "items": [
        "SSE 增量边到边解析，mood 首包定语气，逐句 enqueue 朗读",
        "同一份结果驱动朗读、字幕与 SQLite 落库",
        "播放回执决定 complete 或 interrupted；完成后再后台抽取记忆"
      ]
    }
  ]
}
