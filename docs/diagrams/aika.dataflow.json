      "row": 2
    },
    {
      "id": "hist",
      "type": "database",
      "label": "消息历史",
      "sublabel": "最近 16 轮原文",
      "stage": 2,
      "row": 0
    },
    {
      "id": "ctx",
      "type": "backend",
      "label": "ContextAssembler",
      "sublabel": "预算 4800 · instructions",
      "stage": 2,
      "row": 1
    },
    {
      "id": "mem",
      "type": "database",
      "label": "记忆 top-8 · 摘要",
