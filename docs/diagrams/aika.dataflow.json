  "nodes": [
    {
      "id": "mic",
      "type": "external",
      "label": "麦克风音频",
      "sublabel": "16 kHz · AudioWorklet",
      "stage": 0,
      "row": 1
    },
    {
      "id": "vad",
      "type": "backend",
      "label": "Silero VAD",
      "sublabel": "512 帧 · 380ms 静音切段",
      "stage": 1,
      "row": 0
    },
    {
      "id": "asr",
      "type": "backend",
      "label": "whisper /inference",
      "sublabel": "幻听过滤 · 保序",
      "stage": 1,
      "row": 1
    },
    {
      "id": "turn",
      "type": "backend",
