{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aika",
  "version": "0.3.0",
  "identifier": "com.aika.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "愛花 Aika",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 600,
        "center": true
      },
      {
        "label": "pet",
        "title": "Aika Desktop Pet",
        "url": "index.html",
        "width": 320,
        "height": 420,
        "minWidth": 220,
        "minHeight": 300,
        "center": true,
        "visible": false,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
