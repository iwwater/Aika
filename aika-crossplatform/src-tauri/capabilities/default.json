{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        "https://*",
        "http://localhost:*",
        "http://127.0.0.1:*"
      ]
    },
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "notification:default"
  ]
}
