# Aika desktop-pet local environment
#
# Copy this file to .env and fill only the values needed for the capability you
# are running. The repository ignores .env and .env.*; never commit real keys.
# PowerShell: from this directory run `. .\tools\load-env.ps1`.

# ---------------------------------------------------------------------------
# Test mode
# ---------------------------------------------------------------------------
# Keep 0 for the normal Mock/fixture test suites. Set to 1 only when running
# `npm run test:next:real` against an explicitly authorized real service.
PET_NEXT_REAL=0

# ---------------------------------------------------------------------------
# LLM provider (optional; used by tests/next/real/realLlm.test.ts)
# ---------------------------------------------------------------------------
NEXT_REAL_LLM_KEY=
NEXT_REAL_LLM_ENDPOINT=https://api.deepseek.com/chat/completions
NEXT_REAL_LLM_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# STT / ASR providers (optional)
# ---------------------------------------------------------------------------
# Local sherpa-onnx streaming package. The directory must contain the model
# files expected by the selected adapter.
PET_STREAMING_ASR_DIR=
NEXT_REAL_SHERPA_DIR=

# Local Whisper-compatible HTTP service and a WAV sample for real replay.
NEXT_REAL_WHISPER_ENDPOINT=http://127.0.0.1:8080
NEXT_REAL_ASR_SAMPLE=F:/AIVoice/toolchains/whisper-b5130/jfk.wav

# ---------------------------------------------------------------------------
# TTS provider (optional)
# ---------------------------------------------------------------------------
# Windows SAPI voice name used by the real TTS replay. K65 Mock TTS needs no
# key and does not read this value.
NEXT_REAL_TTS_VOICE=Microsoft Huihui Desktop

# ---------------------------------------------------------------------------
# Local application paths (optional)
# ---------------------------------------------------------------------------
PET_PROJECT_ROOT=F:/AIVoice/Aika-Next/windows/code/desktop-pet
PET_DATABASE=F:/AIVoice/Aika-Next/windows/code/desktop-pet/.local/data/companion.sqlite
PET_TRIAL_CONFIG=
PET_TRIAL_ACTIVATION=

# ---------------------------------------------------------------------------
# Existing local integrations (optional)
# ---------------------------------------------------------------------------
CODEX_HOME=
DSH_HOME=
PET_HARNESS_HOME=
PET_CODEX_EXECUTABLE=
WAKE_MODEL_DIRECTORY=
PLAYWRIGHT_MODULE=
